{
  "login": {
    "username": "#username",
    "password": "#password",
    "submit": "button.woocommerce-form-login__submit",
    "account_name": ".woocommerce-MyAccount-navigation",
    "captcha_marker": ".g-recaptcha, iframe[src*='recaptcha']",
    "mfa_marker": "[data-mfa], .two-factor, input[name*='otp']",
    "cookie_accept": "button:has-text('Accept All')",
    "logout_link": "a:has-text('Logout')"
  },
  "cart": {
    "clear": "a.remove, button.wc-block-cart-item__remove-link",
    "empty_marker": ".wc-block-cart__empty-cart, .cart-empty",
    "line_sku": ".wc-block-components-product-metadata__description, .sku",
    "line_qty": ".wc-block-components-quantity-selector input, input.qty",
    "unexpected_line": ".wc-block-cart-items__row"
  },
  "product": {
    "sku": "[data-product_sku]",
    "name": "h1.product_title, h1",
    "size": ".woocommerce-product-attributes-item--attribute_pa_size .woocommerce-product-attributes-item__value",
    "price": ".amount",
    "stock": ".stock",
    "add_to_cart": "button.single_add_to_cart_button",
    "quantity": "input.qty",
    "variation_select": "select[name^='attribute_']"
  },
  "shipping": {
    "name": "#shipping-first_name, #billing-first_name",
    "last_name": "#shipping-last_name, #billing-last_name",
    "line1": "#shipping-address_1, #billing-address_1",
    "line2": "#shipping-address_2, #billing-address_2",
    "city": "#shipping-city, #billing-city",
    "state": "#shipping-state, #billing-state",
    "postal": "#shipping-postcode, #billing-postcode",
    "phone": "#shipping-phone, #billing-phone, #contact-srx-contact_phone",
    "email": "#email, #billing_email",
    "suggestion": ".pac-container, .address-suggestion",
    "dropship_select": "#order-srx-srx_drop_ship_select",
    "dropship_client_button": "[data-srx-value='Yes - Ship direct to client']"
  },
  "payment": {
    "saved_method": "#radio-control-wc-payment-method-options-nmi, input[name='payment_method']",
    "challenge_marker": "#payment .woocommerce-error, .payment-challenge"
  },
  "review": {
    "total": ".wc-block-components-totals-footer-item .wc-block-formatted-money-amount, .order-total .amount",
    "place_order": "button:has-text('Place Order')"
  },
  "confirmation": {
    "order_id": ".woocommerce-order-overview__order strong, .order-number",
    "total": ".woocommerce-order-overview__total strong"
  },
  "orders_history": {
    "row": ".woocommerce-orders-table tbody tr",
    "order_id": ".woocommerce-orders-table__cell-order-number a"
  }
}
