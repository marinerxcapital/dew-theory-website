# Copy to .env.local and fill in. Stripe can stay empty for mock checkout.

# Stripe (leave empty for mock paid orders — owner connects billing later)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_VIRTUAL_CONSULTATION_PRICE_ID=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin
ADMIN_EMAIL=admin@dewtheory.local
ADMIN_PASSWORD=dew-admin-dev
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
# Optional TOTP 2FA (base32 secret)
# ADMIN_TOTP_SECRET=

# Google Calendar freebusy + event write
# GOOGLE_CALENDAR_ID=
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REFRESH_TOKEN=
# GOOGLE_CALENDAR_HOURS=10,11,13,14,15,16

# Resend transactional email
# RESEND_API_KEY=
# EMAIL_FROM=Dew Theory <noreply@dewtheoryco.com>
# EMAIL_REPLY_TO=

# Booking policy copy (optional)
# BOOKING_DEPOSIT_PERCENT=
# BOOKING_CANCEL_HOURS=

# Virtual consultation
CONSULTATION_ADMIN_EMAIL=
CONSULTATION_SCHEDULING_URL=
CONSULTATION_TIMEZONE=America/Chicago

# Skin Script
SKIN_SCRIPT_MODE=mock
AUTO_FULFILL=true
# RPA fulfillment (production — see docs/SKIN_SCRIPT_RPA_ARCHITECTURE.md)
# SKIN_SCRIPT_MODE=rpa
# SKIN_SCRIPT_RPA_ENABLED=false
# SKIN_SCRIPT_RPA_SERVICE_URL=
# SKIN_SCRIPT_RPA_HMAC_SECRET=
# SKIN_SCRIPT_PORTAL_BASE_URL=
# SKIN_SCRIPT_DRY_RUN=true
# FULFILLMENT_ALERT_WEBHOOK_URL=
# CRON_SECRET=

# Membership packages JSON (optional; null prices = interest list only)
# MEMBERSHIP_PACKAGES_JSON=
