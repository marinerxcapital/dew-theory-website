{
  "name": "dew-theory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "smoke": "node scripts/smoke-checkout.mjs",
    "smoke:routes": "node scripts/smoke-routes.mjs",
    "smoke:all": "node scripts/smoke-checkout.mjs && node scripts/smoke-routes.mjs",
    "continuity": "node scripts/check-project-continuity.mjs",
    "seed:mappings": "node scripts/seed-supplier-mapping-templates.mjs",
    "setup:d1": "node scripts/setup-d1-commerce.mjs",
    "setup:d1:local": "node scripts/setup-d1-commerce.mjs --local",
    "ops:dashboard": "node agent-ops-dashboard/server.mjs",
    "ops:emit": "node agent-ops-dashboard/emit.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@stripe/stripe-js": "^9.10.0",
    "gsap": "3.12.5",
    "next": "^15.5.20",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "autoprefixer": "10.4.20",
    "postcss": "^8.5.19",
    "tailwindcss": "3.4.17",
    "wrangler": "^4.112.0"
  },
  "overrides": {
    "postcss": "^8.5.19"
  }
}
